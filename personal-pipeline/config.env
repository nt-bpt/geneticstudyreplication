# config.env — edit the INPUT section, leave the rest unless you know why.
# Any value can also be overridden from the shell:  THREADS=16 bash .agent/skills/03_align_fastq/03_align_fastq.sh

# ---------------- INPUT: pick ONE kind ----------------
: "${INPUT_TYPE:=cram}"          # cram | bam | fastq
: "${INPUT_FILE:=}"              # path to .cram/.bam   (INPUT_TYPE=cram|bam)
: "${INPUT_REFERENCE:=}"         # FASTA the CRAM was encoded against (only if the CRAM cannot be read without it)
: "${FASTQ_R1:=}"                # (INPUT_TYPE=fastq)
: "${FASTQ_R2:=}"
: "${SAMPLE:=sample}"
: "${THREADS:=4}"

# ---------------- FASTQ alignment ----------------
: "${REFERENCE:=}"               # existing GRCh38 FASTA to align to; empty = skill 02 downloads one
: "${ALIGN_SCOPE:=full}"         # full      = whole GRCh38 (correct, slow: hours to days)
                                 # chr3_only = chr3 only (fast, but reads from other genome regions that resemble
                                 #             chr3 get forced onto it -> inflated depth and false variants)
# ---------------- Output naming ----------------
: "${OUTPUT_CHR_STYLE:=}"        # ""=keep what the data uses | ucsc (chr3) | ensembl (3) | genbank (CM000665.2) | refseq (NC_000003.12)

# ---------------- Regions of interest, GRCh38 ----------------
# Rempel (2025) text: hotspot 'chr3:75.5 Mb' (GRCh38 30x data); families HG01505 and HG02293 within ~68 kb. The paper gives no
# exact start/end; this window covers the nonparental regions our own trio scan found there (75,446,536-75,591,582).
: "${PRIMARY_START:=75440000}"   # primary hotspot
: "${PRIMARY_END:=75600000}"
: "${EXT_START:=74000000}"       # extended window around it
: "${EXT_END:=77000000}"
: "${CONTROL_START:=70000000}"   # same-chromosome comparison region (no reported signal)
: "${CONTROL_END:=71000000}"

# ---------------- Thresholds (all tunable) ----------------
: "${MIN_MAPQ:=20}"
: "${MIN_QUAL:=30}"              # variant QUAL for PASS
: "${MIN_DP:=8}"                 # variant depth for PASS
: "${AB_MIN_DEPTH:=10}"          # depth needed to judge allele balance at a het site
: "${AB_P_THRESHOLD:=0.001}"     # binomial p below this = site called "skewed"
: "${RATIO_FLAG:=2.0}"           # region rate must exceed control rate by this factor to be flagged
: "${SOFTCLIP_FLOOR_PCT:=2}"     # ...and exceed this absolute percentage (reads with >=10 clipped bases)
: "${SPLIT_FLOOR_PCT:=0.5}"
: "${DISCORDANT_FLOOR_PCT:=1}"
: "${MIN_FLAG_READS:=10}"         # ...and involve at least this many reads
: "${GNOMAD_FLANK:=50000}"       # bases either side of the primary hotspot fetched from gnomAD
: "${GNOMAD_LOCAL_VCF:=}"        # optional: a local, indexed gnomAD sites VCF to use instead of the network
