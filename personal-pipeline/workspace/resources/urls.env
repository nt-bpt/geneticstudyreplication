# URLs used by the personal pipeline.  "listed" = seen in a directory listing / project documentation.
# Nothing here has been downloaded from inside the authoring sandbox; skills probe URLs at run time and log which one worked.

# GRCh38 reference with decoys + HLA (the one the 1000 Genomes high-coverage CRAMs use). Contigs are named chrN.   [listed]
GRCH38_FULL_URLS="http://ftp.1000genomes.ebi.ac.uk/vol1/ftp/technical/reference/GRCh38_reference_genome/GRCh38_full_analysis_set_plus_decoy_hla.fa https://1000genomes.s3.amazonaws.com/technical/reference/GRCh38_reference_genome/GRCh38_full_analysis_set_plus_decoy_hla.fa"
# bwa alt-aware mapping uses a sibling ".alt" file; its location was NOT confirmed — skill 02 tries it and carries on without.
# chr3 alone from UCSC (header is ">chr3")                                                                         [downloaded OK by the user earlier]
UCSC_CHR3_URL="https://hgdownload.soe.ucsc.edu/goldenPath/hg38/chromosomes/chr3.fa.gz"

# gnomAD v4.1 genomes sites VCF, chr3 (the whole file is ~159 GiB — only ever stream a small region).             [listed]
GNOMAD_V41_GCS="https://storage.googleapis.com/gcp-public-data--gnomad/release/4.1/vcf/genomes/gnomad.genomes.v4.1.sites.chr3.vcf.bgz"
GNOMAD_V41_AWS="https://gnomad-public-us-east-1.s3.amazonaws.com/release/4.1/vcf/genomes/gnomad.genomes.v4.1.sites.chr3.vcf.bgz"
GNOMAD_URLS="$GNOMAD_V41_GCS $GNOMAD_V41_AWS"
