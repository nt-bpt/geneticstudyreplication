# Ghost-ancestry pipeline settings. Copy this file to repo/config.env.
# The pipeline reads settings only from repo/config.env. Relative paths are
# relative to repo/ (write "work", not "repo/work"), and everything the
# pipeline writes (results, logs, work,
# data, tools) stays under repo/. Input files (FASTQ/CRAM) may be anywhere.
# Anything not set here uses the default in lib/pipeline_common.py.

# ---- Input: set EITHER the FASTQ pair OR INPUT_FILE ---------------------
FASTQ_R1=
FASTQ_R2=
INPUT_FILE=                 # .cram or .bam
INPUT_REFERENCE=            # FASTA the CRAM was made with (required for CRAM)
SAMPLE_NAME=ME              # one word, must not match a 1000 Genomes sample ID

# ---- Scope and machine --------------------------------------------------
CHROMOSOMES=22              # start with 22 as a pilot; later e.g. 1-22
THREADS=8
MEMORY_GB=16
MIN_FREE_GB=100
DATA_DIR=data               # downloads (reference, panel, archaic genomes)
WORK_DIR=work               # intermediate files (alignment, ARGs)
TOOLS_DIR=tools             # Beagle, TRACE

# ---- Reference (leave empty to download 1000G GRCh38 analysis set) ------
REFERENCE_FASTA=
ALIGNER=bwa                 # bwa or bwa-mem2

# ---- Genotyping ---------------------------------------------------------
MIN_DP=8
MAX_DP_FACTOR=2.5
MIN_MEAN_DEPTH=10

# ---- Cohort (the paper's 503 samples = these five populations) ----------
COHORT_POPS=GBR CHB ITU YRI LWK

# ---- Phasing ------------------------------------------------------------
BEAGLE_JAR=                 # leave empty to download BEAGLE_URL
# BEAGLE_URL=https://faculty.washington.edu/browning/beagle/<current jar>

# ---- Genealogies (ARG inference) ----------------------------------------
ARG_METHOD=relate           # relate (default) or singer
RELATE_DIR=                 # unpacked Relate folder with bin/ and scripts/, e.g. tools/relate_v1.2.4_x86_64_static
RELATE_MU=1.25e-8           # mutation rate per base per generation
RELATE_N=30000              # HAPLOID effective population size (2 x diploid Ne)
RELATE_POPSIZE=1            # 1 = re-estimate population sizes and branch lengths (recommended)
RELATE_POPSIZE_ITER=5
RELATE_MASK=                # optional GRCh38 mappability mask FASTA; {chrom} or {n} is replaced per chromosome
RELATE_SEED=1

# ---- SINGER (only used when ARG_METHOD=singer) ---------------------------
SINGER_DIR=                 # folder containing singer_master and convert_to_tskit
SINGER_NE=1e4               # check supplementary section S3 for the paper's values
SINGER_MU=1.2e-8
SINGER_RATIO=1
SINGER_WINDOW_BP=1000000
SINGER_N_SAMPLES=100
SINGER_THIN=20
SINGER_JOBS=4               # windows run in parallel; lower if memory runs out
# Placeholders: {singer_dir} {ne} {mu} {ratio} {vcf_prefix} {out_prefix}
#               {start} {end} {n_samples} {thin} {last_sample} {chrom}
# SINGER_CMD_TEMPLATE={singer_dir}/singer_master -Ne {ne} -m {mu} -ratio {ratio} -vcf {vcf_prefix} -output {out_prefix} -start {start} -end {end} -n {n_samples} -thin {thin}
# SINGER_CONVERT_TEMPLATE={singer_dir}/convert_to_tskit -input {out_prefix} -output {out_prefix} -start 0 -end {last_sample} -step 1

# ---- TRACE --------------------------------------------------------------
# REQUIRED before skill 11. Fill in after reading the TRACE README that
# skill 09 downloads. The command must write its segments to {out}.
# Placeholders: {trees} {chrom} {start} {end} {haps} {hap_file} {t} {out}
#               {threads} {trace_dir} {map}
TRACE_CMD_TEMPLATE=
TRACE_OUTPUT_COLUMNS=       # only if TRACE output has no header, e.g. chrom,start,end,hap
TRACE_STATE_COLUMN=         # only if output lists both states, e.g. state
TRACE_ARCHAIC_VALUE=archaic
TRACE_HAP_IDS=nodes         # nodes | index | none
TRACE_POS_OFFSET=auto       # auto | add | none
TRACE_T_GHOST=15000
TRACE_T_SUPER=31500
MIN_SEG_KB=50
MIN_SEG_CM=0.05
SUPER_MIN_SEG_KB=10
SUPER_MIN_SEG_CM=0.01

# ---- Source labelling ---------------------------------------------------
LABEL_DELTA=0.15
MIN_DERIVED_SITES=5
SUPER_MAX_AFFINITY=0.25
