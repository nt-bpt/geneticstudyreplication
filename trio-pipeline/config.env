# config.env — edit if needed; any value can also be overridden from the shell (CHROM=1 bash .agent/skills/03_npa_scan/03_npa_scan.sh)
: "${THREADS:=4}"

# ---------------- what to scan ----------------
: "${CHROM:=3}"                    # chromosome number to scan (3 = the Rempel chromosome; use 1,2,4... for baseline runs)
: "${SCAN_START:=1}"               # bp range scanned. 1..77,000,000 on chr3 is what the preprint is said to have covered (unverified)
: "${SCAN_END:=77000000}"          # 0 = to the end of the chromosome
: "${FOCUS_START:=75440000}"       # claimed hotspot "chr3:75.5 Mb" (paper gives no exact range); covers regions found at 75,446,536-75,591,582
: "${FOCUS_END:=75600000}"

# ---------------- definition of the signal (my reimplementation, NOT Rempel's code) ----------------
# A "nonparental allele" (NPA) = a child allele present in neither parent, at a SNV where all three are called
#   and at least one of the three carries a non-reference allele ("informative" site).
# A window = WINDOW_SNPS consecutive informative sites of that trio. A window is "hot" if it holds >= MIN_WINDOW_NPA NPAs.
# Overlapping hot windows are merged into one region.
: "${WINDOW_SNPS:=60}"
: "${MIN_WINDOW_NPA:=8}"
: "${INCLUDE_INDELS:=no}"          # yes = also use short indels as sites
: "${HIGH_BG_FACTOR:=5}"           # a trio whose NPA rate is >= this x the cohort median is flagged "high background" (sample/pedigree problem?)

# ---------------- context checks ----------------
: "${TOP_N:=50}"                   # regions examined in skill 04, best (lowest p) first
: "${PAD_BP:=5000}"                # padding when testing overlap with segmental duplications / SVs
: "${COMMON_AF:=0.01}"             # NPA allele at >= this cohort frequency counts as "common"

# ---------------- downloads ----------------
: "${MANUAL_DIR:=}"                # folder where YOU already put the downloaded files (skips downloading; see skill 01)

# ---------------- baseline (skill 06) ----------------
# Other chromosomes scanned with the same settings (same SCAN_START..SCAN_END) to learn what a "normal" chromosome gives.
# Each one is a separate multi-GB download. Example: BASELINE_CHROMS="2 4"
: "${BASELINE_CHROMS:=}"

# ---------------- optional ----------------
: "${USE_SEGDUP:=yes}"             # download the UCSC segmental-duplication track (~ a few MB) for skill 04
