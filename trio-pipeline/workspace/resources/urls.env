# URLs for the 1000 Genomes 30x (NYGC) release.   "listed" = seen in a directory listing from the project server.
# Nothing here was downloaded from the authoring sandbox; skill 01 verifies every file after downloading it.

EBI_BASE="https://ftp.1000genomes.ebi.ac.uk/vol1/ftp/data_collections/1000G_2504_high_coverage"
PHASED_DIR="working/20220422_3202_phased_SNV_INDEL_SV"                       # [listed] files named 1kGP_high_coverage_Illumina.chr<N>.filtered.SNV_INDEL_SV_phased_panel.vcf.gz (+ .tbi)
VCF_NAME_PATTERN="1kGP_high_coverage_Illumina.chr@CHROM@.filtered.SNV_INDEL_SV_phased_panel.vcf.gz"
PED_URL="$EBI_BASE/working/1kGP.3202_samples.pedigree_info.txt"              # [listed]
POPTABLE_URL="$EBI_BASE/20130606_g1k_3202_samples_ped_population.txt"        # [listed]
# Other folders listed next to the phased panel (not used by default):
#   working/20201028_3202_raw_GT_with_annot   (raw genotypes — may keep Mendelian-inconsistent calls the phased panel smooths)
#   working/20210124.SV_Illumina_Integration  (SV calls)

# Mirror: NCBI lays the same project out WITHOUT the "data_collections" level, and its working/ folder predates the
# 20220422 release, so the phased panel is probably NOT there.  Tried only as a last resort.
NCBI_BASE="https://ftp-trace.ncbi.nlm.nih.gov/1000genomes/ftp/1000G_2504_high_coverage"
VCF_BASES="$EBI_BASE/$PHASED_DIR $NCBI_BASE/$PHASED_DIR"

# UCSC segmental-duplication track (standard path; not re-checked this session). Optional.
SEGDUP_URL="https://hgdownload.soe.ucsc.edu/goldenPath/hg38/database/genomicSuperDups.txt.gz"
